# COLLECTIQ environment variables
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional: anything left blank runs in a clearly labelled demo mode.

# --- PayPal (REST app from https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID shown after you add https://<your-app>/api/webhooks/paypal in the PayPal dashboard
PAYPAL_WEBHOOK_ID=

# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the scheduler and webhook handler. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Scheduler ---
# Long random string; the cron job sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Public base URL of the deployment (used for links and auth redirects)
APP_URL=http://localhost:3000
